# ── GitHub OAuth App credentials ──────────────────────────────────────────────
# Create an OAuth App at: https://github.com/settings/developers
# Homepage URL:        http://localhost:5500   (your frontend)
# Callback URL:        http://localhost:3000/auth/github/callback

GITHUB_CLIENT_ID=your_client_id_here
GITHUB_CLIENT_SECRET=your_client_secret_here

# ── Optional: a personal access token for unauthenticated fallback ─────────────
# Raises rate limit from 60 → 5000 req/hr for anonymous visitors
# Create at: https://github.com/settings/tokens  (no scopes needed)
GITHUB_TOKEN=

# ── Session ────────────────────────────────────────────────────────────────────
SESSION_SECRET=replace-with-a-long-random-string

# ── URLs ───────────────────────────────────────────────────────────────────────
# Where your frontend is served (CORS origin)
FRONTEND_URL=http://localhost:5500

# Where this backend is running (used in OAuth redirect URI)
BACKEND_URL=http://localhost:3000

# ── Runtime ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
